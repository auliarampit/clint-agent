+++ b/src/features/stories/data/stories.api.ts
@@ -0,0 +1,20 @@
+import { apiRequest } from '@/shared/api/client';
+import { optionalAuth } from '@/shared/api/optional-auth';
+
+export const storiesApi = {
+  async listStories() {
+    return apiRequest('/stories', { ...(await optionalAuth()) });
+  },
+
+  async putStoryLike(uuid: string): Promise<boolean> {
+    const wire = await apiRequest<{ liked: boolean }>(`/stories/${uuid}/like`, {
+      method: 'PUT',
+    });
+    return wire.liked;
+  },
+};
