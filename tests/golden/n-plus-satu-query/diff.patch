diff --git a/src/orders/orders.service.ts b/src/orders/orders.service.ts
index 7c60f14..89d6dfe 100644
--- a/src/orders/orders.service.ts
+++ b/src/orders/orders.service.ts
@@ -6,4 +6,14 @@ export class OrdersService {
   async listOrders(userId: string) {
     return this.db.query('SELECT * FROM orders WHERE user_id = $1', [userId]);
   }
+
+  async listOrdersWithItems(userId: string) {
+    const orders = await this.listOrders(userId);
+    const result = [];
+    for (const order of orders) {
+      const items = await this.db.query('SELECT * FROM order_items WHERE order_id = $1', [order.id]);
+      result.push({ ...order, items });
+    }
+    return result;
+  }
 }
