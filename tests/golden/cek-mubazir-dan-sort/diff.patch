+++ b/src/features/library/hooks/useTempFetch.ts
@@ -0,0 +1,22 @@
+import { useEffect } from 'react';
+
+import type { DownloadFile } from '@/features/library/downloads/download-manager';
+import { tempFetcher } from '@/features/library/downloads/temp-fetcher';
+import { usePlayerStore } from '@/shared/audio/player.store';
+
+export function useTempFetch(uuid: string, file: DownloadFile | null, streaming: boolean): void {
+  const playing = usePlayerStore((state) => state.status === 'playing');
+  const url = file?.url ?? null;
+  const sizeBytes = file?.sizeBytes ?? 0;
+  const active = streaming && playing && url !== null;
+
+  useEffect(() => {
+    if (!active || url === null) {
+      return;
+    }
+    tempFetcher.start(uuid, url, sizeBytes);
+    return () => {
+      void tempFetcher.pause(uuid);
+    };
+  }, [active, uuid, url, sizeBytes]);
+}
