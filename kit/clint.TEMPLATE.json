{
  "baseBranch": "dev",
  "mr": {
    "cli": "glab",
    "targetBranch": "dev",
    "mode": "mr"
  },
  "autoReview": true,
  "autoReviewMinLines": 40,
  "suara": true,
  "ciOnMr": ["{cek yang dijalankan CI pada MR: lint, typecheck, test, sonar, build, e2e}"],
  "worktreeRoot": "../{nama-repo}-worktrees",
  "relatedRepos": [
    {
      "name": "docs",
      "path": "../docs",
      "branch": "main",
      "role": "docs"
    },
    {
      "name": "designs",
      "path": "../designs",
      "branch": "main",
      "role": "design"
    }
  ],
  "docs": {
    "language": "{en / id — bahasa dokumen project; default en}",
    "plans": "{path rencana PR / TIDAK ADA}",
    "requirements": "{path PRD/SAD/STD/API contract / TIDAK ADA}",
    "design": "{path prototype desain / TIDAK ADA}",
    "feedback": "{folder feedback/bug QA / TIDAK ADA}",
    "pic": "{dokumen pembagian tugas/PIC, mis. docs/sprints / TIDAK ADA}"
  },
  "surfaces": [
    {
      "name": "mobile",
      "root": ".",
      "adapter": ".claude/mobile-stack.md",
      "lint": "bun run lint",
      "typecheck": "bun run typecheck",
      "test": "bun run test",
      "testRelated": "{mis. bunx jest --findRelatedTests / bunx vitest related --run / TIDAK ADA}",
      "e2e": "bun run test:e2e",
      "formatFile": "bunx prettier --write"
    }
  ]
}
